APP_NAME=KRISHI AI
DEBUG=true

DATABASE_URL=sqlite:///./krishi_ai.db

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_FOR_KRISHI_AI_JWT_TOKENS_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AI_PROVIDER=huggingface

HF_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
KRISHI_ADAPTER_PATH=./models/krishi-ai-adapter
USE_LORA=false
DEVICE=auto

MAX_NEW_TOKENS=100
DO_SAMPLE=false
TEMPERATURE=0.0
TOP_P=0.9
REPETITION_PENALTY=1.15
NO_REPEAT_NGRAM_SIZE=0

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60

MAX_CHAT_HISTORY=4

FRONTEND_URL=http://localhost:5173

# Phase 2 Voice Configuration
STT_PROVIDER=local
TTS_PROVIDER=local

MAX_AUDIO_FILE_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=120

# Phase 2 Agricultural RAG Configuration
RAG_TOP_K=2
RAG_MAX_CONTEXT_CHARS=600
RAG_SCORE_THRESHOLD=0.45

